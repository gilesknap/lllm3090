[Unit]
Description=lllm3090 control panel (local web UI on 127.0.0.1:8080)
Documentation=https://github.com/gilesknap/lllm3090
After=network-online.target

[Service]
Type=simple
ExecStart=@BIN@ panel
Restart=on-failure
RestartSec=5

# Kill only the panel process on stop, not everything in the cgroup.
#
# The engine is launched by the panel and tracked by a pidfile so that a panel
# restart -- which systemd does on every upgrade -- does not cost a multi-minute
# model reload. start_new_session=True escapes the process group but NOT the
# cgroup, so with the default KillMode=control-group systemd killed the engine
# anyway, and the next request got "connection refused" with no clue why.
#
# The documented downside of KillMode=process is that it can leave processes
# behind. Here that is the point: `lllm3090 stop` owns the engine's lifetime.
KillMode=process

# Nothing in the panel should take long to stop now that starts do not block,
# but 90s of an unresponsive service while systemd waits is worse than a
# hard stop.
TimeoutStopSec=15

[Install]
WantedBy=default.target
